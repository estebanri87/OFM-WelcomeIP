          <Dynamic>
            <ChannelIndependentBlock>
              <!-- Eine Tabellenzeile je Kanal auf der Seite "Kanalauswahl". -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows>
                    <Row Id="%AID%_PB-nnn_R-1" />
                  </Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="15%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" Text="Gerät %C%" />
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%021_R-%TT%%CC%02101" Cell="1,2" HelpContext="BASE-ChannelSelect" />
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Cell="1,3" HelpContext="BASE-ChannelName" />
                </ParameterBlock>
              </ParameterBlock>

              <!-- Der eigentliche Gerätetab, nur für aktivierte Kanäle. -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Channel">
                <choose ParamRefId="%AID%_UP-%TT%%CC%021_R-%TT%%CC%02101">
                  <when test="=1">
                    <ParameterBlock Id="%AID%_PB-nnn" Name="f%CC%WIP" Text="Gerät %C%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" Icon="lock-outline" ShowInComObjectTree="true" HelpContext="WIP-Kanaltyp">
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Gerät" UIHint="Headline" />
                      <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" HelpContext="BASE-ChannelName" />
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" HelpContext="WIP-Kanaltyp" />
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" HelpContext="WIP-Kanaltyp" />
                      <ParameterRefRef RefId="%AID%_UP-%TT%%CC%022_R-%TT%%CC%02201" HelpContext="BASE-ChannelSuspended" />

                      <!-- 1 = Außenstation -->
                      <choose ParamRefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201">
                        <when test="=1">
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Klingeln" UIHint="Headline" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" HelpContext="WIP-Klingeln" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601">
                            <when test="=0">
                              <ParameterRefRef IndentLevel="2" RefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001" HelpContext="WIP-Klingeln" />
                            </when>
                          </choose>
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%011_R-%TT%%CC%01101" HelpContext="WIP-Klingeln" />
                          <ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" />

                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Türöffner" UIHint="Headline" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" HelpContext="WIP-Oeffnungsweg" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" HelpContext="WIP-Oeffnungsweg" />
                          <ComObjectRefRef RefId="%AID%_O-%TT%%CC%001_R-%TT%%CC%00101" />
                          <ComObjectRefRef RefId="%AID%_O-%TT%%CC%002_R-%TT%%CC%00201" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501">
                            <when test="=1">
                              <ComObjectRefRef RefId="%AID%_O-%TT%%CC%003_R-%TT%%CC%00301" />
                            </when>
                          </choose>

                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Türstatus" UIHint="Headline" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%009_R-%TT%%CC%00901" HelpContext="WIP-Kanaltyp" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%009_R-%TT%%CC%00901">
                            <when test="=1">
                              <ComObjectRefRef RefId="%AID%_O-%TT%%CC%004_R-%TT%%CC%00401" />
                            </when>
                          </choose>
                          <ComObjectRefRef RefId="%AID%_O-%TT%%CC%005_R-%TT%%CC%00501" />
                        </when>

                        <!-- 2 = IP-Schaltaktor H8304 -->
                        <when test="=2">
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Türöffner" UIHint="Headline" />
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Schaltdauer und Betriebsart des Ausgangs werden im Smart Access Point eingestellt, nicht hier." UIHint="Information" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="WIP-Oeffnungsweg" />
                          <choose ParamRefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301">
                            <when test="=3">
                              <ParameterRefRef IndentLevel="2" RefId="%AID%_UP-%TT%%CC%018_R-%TT%%CC%01801" HelpContext="WIP-Oeffnungsweg" />
                            </when>
                          </choose>
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" HelpContext="WIP-Oeffnungsweg" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" HelpContext="WIP-Oeffnungsweg" />
